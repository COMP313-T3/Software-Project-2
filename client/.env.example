# Everything in this file ends up in the browser, so never put a secret here.

# Base URL of the API. Leave it empty in development: the dev server forwards /api to http://localhost:4000.
VITE_API_BASE_URL=

# reCAPTCHA site key from the reCAPTCHA admin console. It is public by design. Leave it empty in
# development to use Google's test key, which pairs with the API's test secret key.
VITE_RECAPTCHA_SITE_KEY=

# Google Maps key, for the Competition Map View and sign-up location picker. Browser
# keys are visible to anyone by design. Leave it empty to disable those map features.
VITE_GOOGLE_MAPS_API_KEY=

# Map ID for the Competition Map View and Choose on map pop-up. Leave it empty to use Google's
# DEMO_MAP_ID for development; a regular key needs a Map ID from the Google Cloud project.
VITE_GOOGLE_MAPS_MAP_ID=

# Set to none to stop `npm run dev` in the TopSend folder from opening the app in your browser.
# It's only read by that script and never reaches the browser.
BROWSER=
