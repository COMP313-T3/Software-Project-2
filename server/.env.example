# Port the API listens on.
PORT=4000

# MongoDB connection string, including the database name right before the ?.
# Each developer uses their own. Never commit the real value.
MONGODB_URI=

# Browser origins allowed to call the API, separated by commas, with no trailing slash.
CLIENT_ORIGINS=http://localhost:5173

# development or production (test is for automated tests). The API won't start with any other value.
NODE_ENV=development

# reCAPTCHA secret key from the reCAPTCHA admin console. Never commit the real value.
# Leave it empty in development to use Google's test key, which passes every check.
# Production refuses to start without the real key.
RECAPTCHA_SECRET_KEY=

# Sign-up attempts allowed from one IP address per hour.
SIGNUP_LIMIT_PER_HOUR=50

# Google Maps key the API uses to look up addresses with the Geocoding API. In development it can
# be the same Maps Demo Key as the client's. Leave it empty to turn address lookups off.
GOOGLE_MAPS_SERVER_KEY=

# Address of the web app. Links in emails, such as password reset links, point here.
# Production refuses to start without it.
APP_URL=http://localhost:5173

# SMTP server and account that send account emails, such as password reset links. Never commit the
# real password. For Gmail, SMTP_PASS is a 16-character App Password from
# myaccount.google.com/apppasswords (paste it without the spaces), which needs 2-Step Verification
# on that Google account. While SMTP_USER and SMTP_PASS are empty, development prints each email in
# this terminal instead of sending it, and any other NODE_ENV turns password reset off.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Name and address the emails come from. Leave it empty to use TopSend <SMTP_USER>, which needs
# SMTP_USER to be an email address.
MAIL_FROM=

# Key that login tokens and CSRF tokens are signed with, at least 32 characters. Never commit the
# real value. Make one with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Leave it empty in development to get a random one each time the API starts. Production refuses
# to start without it.
AUTH_SECRET=

# A login ends after this many minutes without activity (3 to 720), and this many hours after
# logging in no matter what (1 to 168).
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12
