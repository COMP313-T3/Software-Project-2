{
  "info": {
    "name": "US028 Event Registration — local acceptance",
    "description": "Backend tasks #109 and #110. Import the local environment generated by server/scripts/us028-local-demo.js, keep cookies enabled, and run in order. Restart the demo and reimport its fresh environment before a clean rerun. Concurrency is verified separately by the real MongoDB Vitest suite.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. Authenticate Climber",
      "item": [
        {
          "name": "Get CSRF token",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/auth/csrf",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.environment.set(\"csrfToken\", pm.response.json().csrfToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Log in as Climber",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) pm.environment.set(\"accessToken\", pm.response.json().token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Successful registration and persistence",
      "item": [
        {
          "name": "Read event before registration",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/competitions/{{competitionId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Three spaces available\", function () { pm.expect(pm.response.json().spacesLeft).to.eql(3); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Register for selected division",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/competitions/{{competitionId}}/registrations",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"divisionId\": \"{{divisionId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"Confirmed registration belongs to selected event\", function () { const r = pm.response.json(); pm.expect(r.status).to.eql(\"CONFIRMED\"); pm.expect(r.competitionId).to.eql(pm.environment.get(\"competitionId\")); pm.expect(r.divisionId).to.eql(pm.environment.get(\"divisionId\")); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Read persisted registration",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/competitions/{{competitionId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Own registration is confirmed; two spaces remain\", function () { const r = pm.response.json(); pm.expect(r.myRegistration.status).to.eql(\"CONFIRMED\"); pm.expect(r.spacesLeft).to.eql(2); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject duplicate registration",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/competitions/{{competitionId}}/registrations",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"divisionId\": \"{{divisionId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 409\", function () { pm.response.to.have.status(409); });",
                  "pm.test(\"Error ALREADY_REGISTERED\", function () { pm.expect(pm.response.json().error).to.eql(\"ALREADY_REGISTERED\"); });"
                ]
              }
            }
          ]
        }
      ]
    },
